layout {
    gaps 8
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width {
        proportion 0.5
    }
    focus-ring {
        off
    }
    border {
        off
    }
    shadow {
        off
    }
}
animations {
    slowdown 0.5
}
prefer-no-csd
gestures {
    hot-corners {
        off
    }
}
hotkey-overlay {
    skip-at-startup
}
