layer-rule {
    match namespace="notifications"
    match namespace="wofi"
    background-effect {
        blur true
        xray false
    }
}
layer-rule {
    match namespace="waybar"
    popups {
        background-effect {
            blur true
            xray false
        }
    }
}
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}
window-rule {
    match app-id="^firefox$"
    match app-id="^spotify$"
    match app-id="^vesktop$"
    match app-id="^org.qbittorrent.qBittorrent$"
    match app-id="Minecraft"
    match app-id="^com.obsproject.Studio$"
    match app-id="^org.wireshark.Wireshark$"
    match app-id="^Tor Browser$"
    match app-id="^losslesscut$"
    open-maximized true
}
window-rule {
    match app-id="^mpv$"
    match app-id="^org.prismlauncher.PrismLauncher$"
    match app-id="^org.gnome.Loupe$"
    open-floating true
}
window-rule {
    match app-id="^firefox$" title="Library"
    open-floating true
    open-maximized false
}
window-rule {
    match app-id="^org.gnome.Nautilus$"
    open-floating true
    default-column-width {
        proportion 0.8
    }
    default-window-height {
        proportion 0.8
    }
}
